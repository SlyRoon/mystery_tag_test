APP_NAME="Mystery Tag Test"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mystery_tag
DB_USERNAME=mystery_tag
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-local-only
DB_QUEUE_CONNECTION=mysql
DB_QUEUE_RETRY_AFTER=30

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=database

PARTNER_API_URL=http://mock-partner:9000/postback
MOCK_PARTNER_STATUS=200
MOCK_PARTNER_DELAY_MS=0
PARTNER_CONNECT_TIMEOUT=2
PARTNER_HTTP_TIMEOUT=5
WORKER_TIMEOUT=15
DELIVERY_LEASE_SECONDS=45
RECOVERY_LEASE_SECONDS=600
REDIS_RESERVATION_LEASE_MS=15000
